@startuml
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FFFFCC
    BorderColor #333333
    ArrowColor #333333
}

package "pkg Manage Online Exams" {

    ' =================== BOUNDARY ===================
    class ExamManagementView <<boundary>> {
        + createExam(data : Object) : void
        + updateExam(id : int, data : Object) : void
        + deleteExam(id : int) : void
        + updateExamQuestions(examId : int, questions : List) : void
        + viewExamAttempts(examId : int) : void
    }

    class ExamTakingView <<boundary>> {
        + viewPendingExams(studentId : int) : void
        + startExam(examId : int, studentId : int) : void
        + selectAnswer(questionId : int, answerData : Object) : void
        + saveAnswers(attemptId : int, answers : List) : void
        + submitExam(attemptId : int, answers : List) : void
    }

    class ExamResultView <<boundary>> {
        + viewResult(attemptId : int) : void
        + viewCompletedExams(studentId : int) : void
    }

    ' =================== CONTROL ===================
    class OnlineExamController <<control>> {
        - apiClient : AxiosInstance
        + createExam(data : Object) : Exam
        + getExams() : List
        + getExamDetail(id : int) : Exam
        + updateExam(id : int, data : Object) : Exam
        + deleteExam(id : int) : void
        + updateExamQuestions(id : int, questions : List) : void
        + getExamQuestions(id : int) : List
        + getExamAttempts(examId : int) : List
        + getPendingExams(studentId : int) : List
        + getCompletedExams(studentId : int) : List
        + startExam(examId : int, studentId : int) : Object
        + getExamAttempt(attemptId : int) : Object
        + saveAnswers(attemptId : int, answers : List) : void
        + submitExam(attemptId : int, answers : List) : Object
    }

    class GradingService <<control>> {
        + gradeQuestion(question : Question, studentAnswer : Object, maxPoints : float) : float
        + gradeMultipleChoice(question : Question, studentAnswer : Object, maxPoints : float) : float
        + gradeTrueFalse(question : Question, studentAnswer : Object, maxPoints : float) : float
        + gradeOrdering(question : Question, studentAnswer : Object, maxPoints : float) : float
        + gradeFillBlank(question : Question, studentAnswer : Object, maxPoints : float) : float
        + convertToScale10(rawScore : float, totalMaxScore : float) : float
    }

    ' =================== ENTITY ===================
    class Exam <<entity>> {
        - id : int
        - title : String
        - description : String
        - created_by : int
        - classroom_id : int
        - duration_minutes : int
        - max_attempts : int
        - show_results_immediately : boolean
        - is_published : boolean
        - publish_at : DateTime
        - generation_config : JSON
        - created_at : DateTime
        - updated_at : DateTime
    }

    class ExamQuestion <<entity>> {
        - id : int
        - exam_id : int
        - question_id : int
        - order : int
        - points : float
    }

    class ExamAttempt <<entity>> {
        - id : int
        - exam_id : int
        - student_id : int
        - status : String
        - start_time : DateTime
        - end_time : DateTime
        - final_score : float
        + is_expired() : boolean
        + auto_complete() : void
    }

    class OnlineAnswer <<entity>> {
        - id : int
        - attempt_id : int
        - question_id : int
        - answer_data : JSON
        - score : float
    }

    ' =================== RELATIONSHIPS ===================
    ' Boundary --> Control (Dependency)
    ExamManagementView ..> OnlineExamController
    ExamTakingView ..> OnlineExamController
    ExamResultView ..> OnlineExamController

    ' Control --> Control (Dependency)
    OnlineExamController ..> GradingService

    ' Control --> Entity (Dependency)
    OnlineExamController ..> Exam
    OnlineExamController ..> ExamQuestion
    OnlineExamController ..> ExamAttempt
    OnlineExamController ..> OnlineAnswer
    GradingService ..> OnlineAnswer

    ' Entity --> Entity (Composition)
    Exam "1" *-- "*" ExamQuestion
    Exam "1" *-- "*" ExamAttempt
    ExamAttempt "1" *-- "*" OnlineAnswer
}

@enduml
