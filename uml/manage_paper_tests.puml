@startuml
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FFFFCC
    BorderColor #333333
    ArrowColor #333333
}

package "pkg Manage Paper Tests" {

    ' =================== BOUNDARY ===================
    class PaperTestManagementView <<boundary>> {
        + createTest(data : Object) : void
        + updateTest(id : int, data : Object) : void
        + deleteTest(id : int) : void
        + generatePreviewPDF(data : Object) : void
        + downloadAllVariants(testId : int) : void
        + downloadVariant(testId : int, variantCode : String) : void
        + viewAnswerKeys(testId : int) : void
    }

    class OMRScanView <<boundary>> {
        + uploadSubmission(testId : int, image : File) : void
        + uploadBatchSubmission(testId : int, images : List) : void
        + viewSubmissionSummary(testId : int) : void
        + deleteSubmission(submissionId : int) : void
    }

    class StatisticsView <<boundary>> {
        + viewTestStatistics() : void
        + viewTestQuestionStats(testId : int) : void
        + viewDashboard() : void
    }

    ' =================== CONTROL ===================
    class PaperTestController <<control>> {
        - apiClient : AxiosInstance
        + getAllTests() : List
        + getTestById(id : int) : PaperTest
        + createTest(data : Object) : PaperTest
        + updateTest(id : int, data : Object) : PaperTest
        + deleteTest(id : int) : void
        + generateTestVariants(test : PaperTest, numVariants : int) : void
        + getTestSummary() : List
        + getAnswerKeys(testId : int) : Object
        + generateFullTestPDF(data : Object) : File
        + downloadAllVariants(testId : int) : File
        + downloadVariant(testId : int, variantCode : String) : File
    }

    class SubmissionController <<control>> {
        - apiClient : HttpClient
        + uploadSubmission(testId : int, image : File) : Object
        + uploadBatchSubmission(testId : int, images : List) : Object
        + getSubmissionSummary(testId : int) : List
        + deleteSubmission(id : int) : void
        + getStudentDetails(studentId : int) : List
    }

    class OMRProcessor <<control>> {
        + getPaperTransform(imagePath : String) : Object
        + findCornerMarkers(gray : Image) : Object
        + validateMarkerGeometry(markerData : Object) : Object
        + detectBubbleDigits(threshRegion : Image, numDigits : int) : List
        + readAnswerBubbles(thresh : Image, template : Object) : List
        + gradeSubmission(submission : PaperSubmission) : float
        + processSubmissionLocal(submissionId : int, imagePath : String) : Object
    }

    class OMRSheetGenerator <<control>> {
        + generateOMRSheet(title : String, variantCode : String, numQuestions : int, numChoices : int, questions : List) : Blob
        + buildVariantQuestions(variant : PaperTestVariant, allQuestions : Object) : List
    }

    ' =================== ENTITY ===================
    class PaperTest <<entity>> {
        - id : int
        - title : String
        - description : String
        - num_questions : int
        - num_choices : int
        - allow_multiple_answers : boolean
        - created_by : int
        - classroom_id : int
        - num_variants : int
        - created_at : DateTime
    }

    class PaperTestQuestion <<entity>> {
        - id : int
        - test_id : int
        - question_id : int
        - order : int
        + get_correct_answer_indices() : List
    }

    class PaperTestVariant <<entity>> {
        - id : int
        - test_id : int
        - variant_code : String
        - question_order : JSON
        - answer_shuffles : JSON
        - created_at : DateTime
        + get_answer_key() : Object
    }

    class PaperSubmission <<entity>> {
        - id : int
        - test_id : int
        - user_id : int
        - student_id : int
        - variant_id : int
        - detected_mssv : String
        - submission_image : CloudinaryField
        - submitted_at : DateTime
        - total_score : float
    }

    class PaperAnswerDetected <<entity>> {
        - id : int
        - submission_id : int
        - question_id : int
        - is_correct : boolean
        - score : float
    }

    class PaperUserAnswer <<entity>> {
        - id : int
        - submission_id : int
        - question_id : int
        - selected_options : JSON
    }

    ' =================== RELATIONSHIPS ===================
    ' Boundary --> Control (Dependency)
    PaperTestManagementView ..> PaperTestController
    OMRScanView ..> SubmissionController
    StatisticsView ..> PaperTestController

    ' Control --> Control (Dependency)
    SubmissionController ..> OMRProcessor
    PaperTestController ..> OMRSheetGenerator

    ' Control --> Entity (Dependency)
    PaperTestController ..> PaperTest
    PaperTestController ..> PaperTestQuestion
    PaperTestController ..> PaperTestVariant
    SubmissionController ..> PaperSubmission
    OMRProcessor ..> PaperSubmission
    OMRProcessor ..> PaperAnswerDetected
    OMRProcessor ..> PaperUserAnswer
    OMRProcessor ..> PaperTestVariant
    OMRSheetGenerator ..> PaperTestVariant

    ' Entity --> Entity (Composition)
    PaperTest "1" *-- "*" PaperTestQuestion
    PaperTest "1" *-- "*" PaperTestVariant
    PaperTest "1" *-- "*" PaperSubmission
    PaperSubmission "1" *-- "*" PaperAnswerDetected
    PaperSubmission "1" *-- "*" PaperUserAnswer
}

@enduml
